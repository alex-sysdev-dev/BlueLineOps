NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated owner emails allowed through Enterprise Login.
ENTERPRISE_ACCESS_EMAILS=
# Comma-separated approved reviewer emails allowed into the live app in view-only mode.
VIEW_ONLY_ACCESS_EMAILS=
# Local-only developer bypass for reviewing protected pages without magic-link auth. Ignored in production.
LOCAL_DEV_PLATFORM_ACCESS=false
# Facility key used for agent permissions and recommendation review. Defaults to default when unset.
BLUE_LINEOPS_FACILITY_ID=default
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_AGENT_MODEL=
RESEND_API_KEY=
# Optional. Defaults to xpertmarxman@gmail.com when unset.
CONTACT_SALES_TO_EMAIL=
# Optional. Defaults to BlueLineOps <onboarding@resend.dev> when unset.
CONTACT_SALES_FROM_EMAIL=
# Optional. Defaults to CONTACT_SALES_FROM_EMAIL when unset.
PASSWORD_RESET_FROM_EMAIL=
# Optional. Comma-separated account email to delivery inbox mappings for Resend testing limits.
PASSWORD_RESET_EMAIL_DELIVERY_OVERRIDES=
